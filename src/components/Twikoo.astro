---
// src/components/Twikoo.astro
const envId = "https://comment.wyc.cc"; 
---

<div id="tcomment" class="mt-8 mb-4 w-full rounded-2xl bg-[var(--card-bg)] p-6 shadow-[var(--card-shadow)]" data-env-id={envId}></div>

<script>
  function loadTwikoo() {
    const container = document.getElementById('tcomment');
    // 如果当前页面没有评论框（例如首页、关于页），直接跳过
    if (!container) return;
    
    const envId = container.getAttribute('data-env-id');

    // @ts-ignore：跳过 TS 类型检查
    if (window.twikoo) {
      // @ts-ignore
      window.twikoo.init({ envId: envId, el: '#tcomment' });
    } else {
      const script = document.createElement('script');
      script.src = 'https://registry.npmmirror.com/twikoo/1.7.7/files/dist/twikoo.min.js';
      script.onload = () => {
        // @ts-ignore
        window.twikoo.init({ envId: envId, el: '#tcomment' });
      };
      document.head.appendChild(script);
    }
  }

  const setupTwikoo = () => {
    // 1. 初次加载
    loadTwikoo();
    
    // 2. 挂载到 Fuwari 的 Swup 页面视图切换事件上
    // @ts-ignore
    if (window.swup && window.swup.hooks) {
      // @ts-ignore
      window.swup.hooks.on("page:view", () => {
        loadTwikoo();
      });
    }
  };

  // 兼容 Fuwari 主题的原生 Swup 初始化逻辑
  // @ts-ignore
  if (window?.swup?.hooks) {
    setupTwikoo();
  } else {
    document.addEventListener("swup:enable", setupTwikoo);
  }
</script>